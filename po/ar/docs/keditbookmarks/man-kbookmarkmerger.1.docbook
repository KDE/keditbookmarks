<refentry lang="&language;">
<refentryinfo>
	<title
>دليل مستخدم &kbookmarkmerger;</title>
	<author
>&Frerich.Raabe; &Frerich.Raabe.mail; </author>
	<date
>2016-11-07</date>
	<releaseinfo
>تطبيقات 16.12</releaseinfo>
	<productname
